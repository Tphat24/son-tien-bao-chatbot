NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://sontienbao.com,https://www.sontienbao.com
ADMIN_API_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Khóa riêng bảo vệ Dynamic API. Không phải OA access token.
# Ưu tiên gửi qua header X-STB-Chatbot-Key. Nếu giao diện Zalo không hỗ trợ header,
# có thể dùng query ?key=... và bật REDACT_DYNAMIC_KEY_IN_LOGS=true.
DYNAMIC_API_KEY=replace_with_a_second_long_random_secret
DYNAMIC_API_TIMEOUT_MS=1800
AI_TIMEOUT_MS=15000
AI_JOB_TTL_MINUTES=30
REDACT_DYNAMIC_KEY_IN_LOGS=true

# ==========================================================
# CHỌN KÊNH ZALO: 'bot' = Zalo Bot Creator (cũ) | 'oa' = Official Account (mới)
# ==========================================================
ZALO_CHANNEL=oa

# ----- Zalo Bot Creator (kênh cũ, giữ để tương thích) -----
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET_TOKEN=
ZALO_ADMIN_CHAT_ID=

# ----- Zalo Official Account (OA) -----
# Lấy từ https://developers.zalo.me → ứng dụng OA của bạn.
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_ID=
# Dán refresh token 1 lần (từ Zalo OA Explorer). Sau đó hệ thống tự làm mới token.
ZALO_OA_REFRESH_TOKEN=
# URL callback OAuth, ví dụ: https://YOUR_DOMAIN/api/zalo-oa/oauth/callback
ZALO_OA_REDIRECT_URI=
# User ID quản trị viên trên OA để nhận thông báo lead (tùy chọn).
ZALO_OA_ADMIN_USER_ID=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MAX_PRODUCTS=5
AI_MAX_KNOWLEDGE_DOCS=5
AI_CACHE_TTL_MINUTES=1440

# Website chatbot
WEB_CHAT_REQUEST_TIMEOUT_MS=40000
WEB_CHAT_RATE_LIMIT_PER_10_MIN=30

# Smart website retrieval
LIVE_WEBSITE_SEARCH_ENABLED=true
LIVE_WEBSITE_MAX_PAGES=8
WEBSITE_FETCH_TIMEOUT_MS=7000

# Email thông báo lead. Để trống SMTP_PASS nếu chưa dùng email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ctytienbao@gmail.com
SMTP_PASS=
MAIL_FROM="Sơn Tiến Bảo Chatbot <ctytienbao@gmail.com>"
MAIL_TO=ctytienbao@gmail.com

# Company settings
COMPANY_NAME=Công ty TNHH Tư vấn Xây dựng Tiến Bảo
COMPANY_WEBSITE=https://sontienbao.com/
COMPANY_HOTLINE=0913712195
COMPANY_EMAIL=ctytienbao@gmail.com

# Tài khoản super admin khởi tạo (chỉ dùng cho lệnh: npm run seed:admin)
SEED_ADMIN_EMAIL=admin@sontienbao.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị viên

# Liên hệ trực tiếp
DIRECTOR_PHONE=0913712195
DIRECTOR_ZALO_URL=https://zalo.me/0913712195

# ---- Tài khoản super admin đầu tiên (chỉ dùng cho lệnh npm run seed:admin) ----
# Chạy 1 lần để tạo tài khoản đăng nhập trang quản trị, sau đó nên xóa/để trống.
SEED_ADMIN_EMAIL=admin@sontienbao.com
SEED_ADMIN_PASSWORD=DoiMatKhauNgaySauKhiDangNhap
SEED_ADMIN_NAME=Quản trị viên
